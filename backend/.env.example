GROQ_API_KEY=replace-with-your-groq-api-key
TAVILY_API_KEY=replace-with-your-tavily-api-key
# optional: raises NCBI rate limit from 3 to 10 requests/second
NCBI_API_KEY=replace-with-your-ncbi-api-key
NCBI_EMAIL=you@example.com
# root agent (planner/synthesiser) and cheap sub-agents / reviewer
ROOT_MODEL=llama-3.3-70b-versatile
SUB_MODEL=llama-3.1-8b-instant
VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# default per-run token budget (UI slider can lower it)
TOKEN_LIMIT=30000
MAX_STEPS=10
